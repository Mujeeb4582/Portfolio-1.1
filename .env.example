# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Resend API key (https://resend.com/api-keys) — required for /api/contact to deliver mail.
RESEND_API_KEY=

# Optional: override the default sender/recipient used by app/api/contact/route.ts.
# CONTACT_FROM_ADDRESS="Portfolio <onboarding@resend.dev>"
# CONTACT_TO_ADDRESS="you@example.com"

# Optional: override the canonical site URL used by app/layout.tsx, app/sitemap.ts, app/robots.ts.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
